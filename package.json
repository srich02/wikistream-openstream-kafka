{
  "name": "kafka-project",
  "version": "1.0.0",
  "description": "High-throughput Kafka + Wikimedia streaming analytics project in Node.js",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev:producer": "tsx src/producer/wikimedia-producer.ts",
    "dev:consumer:analytics": "tsx src/consumers/analytics-consumer.ts",
    "dev:consumer:opensearch": "tsx src/consumers/opensearch-consumer.ts",
    "dev:consumer:replay": "tsx src/consumers/replay-consumer.ts",
    "dev:topics:create": "tsx src/scripts/create-topics.ts",
    "dev:topics:describe": "tsx src/scripts/describe-topics.ts",
    "start:producer": "node dist/producer/wikimedia-producer.js",
    "start:consumer:analytics": "node dist/consumers/analytics-consumer.js",
    "start:consumer:opensearch": "node dist/consumers/opensearch-consumer.js",
    "start:consumer:replay": "node dist/consumers/replay-consumer.js",
    "start:topics:create": "node dist/scripts/create-topics.js",
    "start:topics:describe": "node dist/scripts/describe-topics.js"
  },
  "keywords": [
    "kafka",
    "wikimedia",
    "nodejs",
    "typescript",
    "opensearch",
    "streaming"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@opensearch-project/opensearch": "^3.5.1",
    "dotenv": "^17.3.1",
    "eventsource-parser": "^3.0.6",
    "kafkajs": "^2.2.4",
    "pino": "^10.3.1",
    "undici": "^7.24.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
